@model SmartCampus.Web.Models.Entities.Floor
@using SmartCampus.Web.Models.Enums
@{
    ViewData["Title"] = $"Rooms & Locations - {Model.FloorName}";
}

<div class="ums-page-header">
    <div class="container-fluid px-lg-5 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="ums-page-title"><i class="bi bi-geo-alt me-2"></i>@Model.Building?.BuildingCode &bull; @Model.FloorName</h4>
            <div class="ums-breadcrumb text-muted">
                <a asp-action="Index" class="text-decoration-none">Buildings</a> &bull; 
                <a asp-action="Floors" asp-route-id="@Model.BuildingId" class="text-decoration-none">@Model.Building?.BuildingCode Floors</a> &bull; 
                Room & QR Directory
            </div>
        </div>
        <a asp-action="Floors" asp-route-id="@Model.BuildingId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Floors
        </a>
    </div>
</div>

<div class="container-fluid px-lg-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 small mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4">
        <!-- Add Location Form -->
        <div class="col-md-4">
            <div class="ums-card p-4">
                <h6 class="fw-bold mb-3" style="color: #0f2b48;"><i class="bi bi-plus-circle me-1"></i> Add Room / Location</h6>
                <form asp-action="AddLocation" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="floorId" value="@Model.FloorId" />

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Room / Doorplate #</label>
                        <input type="text" name="roomNumber" class="form-control" placeholder="e.g. 32-405, Lab-4" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Location Name</label>
                        <input type="text" name="locationName" class="form-control" placeholder="e.g. Cloud Computing Lab" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Location Type</label>
                        <select name="locationType" class="form-select" asp-items="Html.GetEnumSelectList<LocationType>()"></select>
                    </div>

                    <button type="submit" class="btn btn-ums-primary w-100">
                        <i class="bi bi-qr-code me-1"></i> Save & Generate QR Code
                    </button>
                </form>
            </div>
        </div>

        <!-- Locations List with QR Code Preview -->
        <div class="col-md-8">
            <div class="ums-card">
                <div class="ums-card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-qr-code me-2"></i>Locations & Dynamic QR Codes (@Model.Locations.Count)</span>
                </div>
                <div class="table-responsive">
                    <table class="table ums-table align-middle">
                        <thead>
                            <tr>
                                <th>Room #</th>
                                <th>Name / Facility</th>
                                <th>Type</th>
                                <th>Unique QR Code GUID</th>
                                <th>QR Code Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Locations.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No rooms configured on this floor yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var loc in Model.Locations.OrderBy(l => l.RoomNumber))
                                {
                                    <tr>
                                        <td class="fw-bold font-monospace text-primary">@loc.RoomNumber</td>
                                        <td class="fw-semibold">@loc.LocationName</td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@loc.LocationType</span>
                                        </td>
                                        <td class="small font-monospace text-muted">
                                            @loc.LocationGuid.ToString().Substring(0, 8)...
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-dark" 
                                                    onclick="showQrModal('@loc.LocationGuid', '@loc.RoomNumber - @loc.LocationName')">
                                                <i class="bi bi-qr-code-scan me-1"></i> View / Print QR
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dynamic QR Code Preview Modal -->
<div class="modal fade" id="qrModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="qrModalLabel">Campus Doorplate QR Code</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div id="qrLoading" class="spinner-border text-primary my-4" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div id="qrContent" style="display: none;">
                    <div class="p-3 border rounded d-inline-block bg-white shadow-sm mb-3">
                        <img id="qrImage" src="" alt="QR Code" class="img-fluid" style="width: 220px; height: 220px;" />
                    </div>
                    <h5 id="qrLocationTitle" class="fw-bold text-dark mb-1"></h5>
                    <p class="text-muted small mb-3">Scan to instantly pre-populate location and report a campus issue.</p>
                    <div class="p-2 bg-light rounded text-break font-monospace small" id="qrTargetUrl"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-ums-primary btn-sm" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print Doorplate Sticker
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showQrModal(guid, locationName) {
            const modal = new bootstrap.Modal(document.getElementById('qrModal'));
            document.getElementById('qrLoading').style.display = 'inline-block';
            document.getElementById('qrContent').style.display = 'none';
            modal.show();

            fetch(`/api/LocationApi/qr-image/${guid}`)
                .then(r => r.json())
                .then(data => {
                    document.getElementById('qrImage').src = data.base64Image;
                    document.getElementById('qrLocationTitle').innerText = locationName;
                    document.getElementById('qrTargetUrl').innerText = data.targetUrl;
                    document.getElementById('qrLoading').style.display = 'none';
                    document.getElementById('qrContent').style.display = 'block';
                })
                .catch(err => {
                    alert('Error generating dynamic QR code: ' + err);
                });
        }
    </script>
}
