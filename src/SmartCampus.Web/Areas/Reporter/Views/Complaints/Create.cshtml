@using SmartCampus.Web.Models.Entities
@{
    ViewData["Title"] = "Report Campus Maintenance Issue";
    var categories = ViewBag.Categories as IEnumerable<IssueCategory>;
    var buildings = ViewBag.Buildings as IEnumerable<Building>;
    var lockedLoc = ViewBag.LockedLocation as Location;
}

<div class="ums-page-header">
    <div class="container-fluid px-lg-5 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="ums-page-title"><i class="bi bi-plus-circle-fill text-warning me-2"></i>Report Campus Issue</h4>
            <div class="ums-breadcrumb text-muted">
                Lovely Professional University &bull; Facilities Maintenance &bull; Quick Dispatch
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-card-checklist me-1"></i> My Complaints
        </a>
    </div>
</div>

<div class="container-fluid px-lg-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger py-2 small mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
                </div>
            }

            <div class="ums-card p-4 shadow-sm">
                <form asp-action="Create" method="post" enctype="multipart/form-data" id="reportForm">
                    @Html.AntiForgeryToken()

                    <!-- Location Section -->
                    <div class="mb-4 pb-3 border-bottom">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-bold mb-0" style="color: #0f2b48;">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> 1. Campus Fault Location
                            </h6>
                            @if (lockedLoc != null)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-qr-code-scan me-1"></i> Auto-Populated via QR Code
                                </span>
                            }
                        </div>

                        @if (lockedLoc != null)
                        {
                            <!-- Locked QR Location Card -->
                            <div class="p-3 bg-light border border-success rounded">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <div class="fw-bold text-dark fs-6">
                                            @lockedLoc.Floor?.Building?.BuildingCode &bull; @lockedLoc.RoomNumber (@lockedLoc.LocationName)
                                        </div>
                                        <div class="small text-muted">
                                            @lockedLoc.Floor?.Building?.BuildingName &bull; @lockedLoc.Floor?.FloorName
                                        </div>
                                    </div>
                                    <div class="col-md-4 text-md-end mt-2 mt-md-0">
                                        <span class="badge bg-success px-3 py-2">Location Confirmed</span>
                                    </div>
                                </div>
                            </div>
                            <input type="hidden" name="locationId" value="@lockedLoc.LocationId" />
                        }
                        else
                        {
                            <!-- Cascading Dynamic Selectors -->
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Building / Block</label>
                                    <select id="buildingSelect" class="form-select" onchange="loadFloors(this.value)" required>
                                        <option value="">-- Select Building --</option>
                                        @if (buildings != null)
                                        {
                                            foreach (var b in buildings)
                                            {
                                                <option value="@b.BuildingId">@b.BuildingCode - @b.BuildingName</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Floor Level</label>
                                    <select id="floorSelect" class="form-select" onchange="loadLocations(this.value)" disabled required>
                                        <option value="">-- Select Floor --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Room / Exact Location</label>
                                    <select id="locationSelect" name="locationId" class="form-select" disabled required>
                                        <option value="">-- Select Room / Facility --</option>
                                    </select>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Category Section -->
                    <div class="mb-4 pb-3 border-bottom">
                        <h6 class="fw-bold mb-3" style="color: #0f2b48;">
                            <i class="bi bi-tools text-primary me-1"></i> 2. Issue Category
                        </h6>
                        <div class="row g-2">
                            @if (categories != null)
                            {
                                int catIndex = 0;
                                foreach (var cat in categories)
                                {
                                    bool isChecked = catIndex == 0;
                                    catIndex++;
                                    <div class="col-sm-6 col-md-4">
                                        <input type="radio" class="btn-check" name="categoryId" id="cat_@cat.CategoryId" 
                                               value="@cat.CategoryId" @(isChecked ? "checked" : "") autocomplete="off" />
                                        <label class="btn btn-outline-secondary w-100 p-3 text-start d-flex align-items-center" for="cat_@cat.CategoryId">
                                            <i class="bi @cat.IconCssClass fs-4 me-3 text-primary"></i>
                                            <div>
                                                <div class="fw-bold small text-dark">@cat.CategoryName</div>
                                                <div class="text-muted" style="font-size: 0.72rem;">@cat.Description</div>
                                            </div>
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Problem Details Section -->
                    <div class="mb-4 pb-3 border-bottom">
                        <h6 class="fw-bold mb-3" style="color: #0f2b48;">
                            <i class="bi bi-pencil-square text-success me-1"></i> 3. Problem Description
                        </h6>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Short Issue Summary / Title</label>
                            <input type="text" name="title" class="form-control" placeholder="e.g. Water leaking from ceiling AC in Lab 1" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Detailed Description</label>
                            <textarea name="description" class="form-control" rows="4" 
                                      placeholder="Provide specific details about the malfunction, hazard level, or exact location within the room..." required></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Callback Contact Number (Optional)</label>
                            <input type="tel" name="contactPhone" class="form-control" placeholder="+91 98765 43210" maxlength="25" />
                        </div>
                    </div>

                    <!-- Photo Upload Section -->
                    <div class="mb-4">
                        <h6 class="fw-bold mb-3" style="color: #0f2b48;">
                            <i class="bi bi-camera-fill text-warning me-1"></i> 4. Upload Photographs (1 to 3 Images)
                        </h6>
                        <p class="text-muted small">
                            Visual evidence helps the Control Desk and technicians dispatch the right tools and spare parts. (Max 10MB per file: JPEG, PNG, WebP)
                        </p>
                        <input type="file" name="photos" class="form-control" multiple accept="image/jpeg,image/png,image/webp" />
                    </div>

                    <!-- Submit Buttons -->
                    <div class="d-flex justify-content-end gap-2 pt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-ums-orange px-4 py-2">
                            <i class="bi bi-send-fill me-1"></i> Submit Campus Complaint
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadFloors(buildingId) {
            const floorSelect = document.getElementById('floorSelect');
            const locSelect = document.getElementById('locationSelect');
            floorSelect.innerHTML = '<option value="">-- Select Floor --</option>';
            locSelect.innerHTML = '<option value="">-- Select Room / Facility --</option>';
            locSelect.disabled = true;

            if (!buildingId) {
                floorSelect.disabled = true;
                return;
            }

            fetch(`/api/LocationApi/floors/${buildingId}`)
                .then(r => r.json())
                .then(floors => {
                    floors.forEach(f => {
                        const opt = document.createElement('option');
                        opt.value = f.floorId;
                        opt.innerText = f.floorName;
                        floorSelect.appendChild(opt);
                    });
                    floorSelect.disabled = false;
                });
        }

        function loadLocations(floorId) {
            const locSelect = document.getElementById('locationSelect');
            locSelect.innerHTML = '<option value="">-- Select Room / Facility --</option>';

            if (!floorId) {
                locSelect.disabled = true;
                return;
            }

            fetch(`/api/LocationApi/locations/${floorId}`)
                .then(r => r.json())
                .then(locations => {
                    locations.forEach(l => {
                        const opt = document.createElement('option');
                        opt.value = l.locationId;
                        opt.innerText = `${l.roomNumber} - ${l.locationName}`;
                        locSelect.appendChild(opt);
                    });
                    locSelect.disabled = false;
                });
        }
    </script>
}
