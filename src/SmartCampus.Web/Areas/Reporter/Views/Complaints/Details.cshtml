@model SmartCampus.Web.Models.Entities.Complaint
@using SmartCampus.Web.Models.Enums
@{
    ViewData["Title"] = $"Ticket {Model.TicketNumber} Progress Details";
    var currentStatusInt = (int)Model.Status;
}

<div class="ums-page-header">
    <div class="container-fluid px-lg-5 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="ums-page-title">
                <i class="bi bi-ticket-detailed me-2"></i>Ticket @Model.TicketNumber: @Model.Title
            </h4>
            <div class="ums-breadcrumb text-muted">
                <a asp-action="Index" class="text-decoration-none">My Complaints</a> &bull; Ticket Details & Audit Timeline
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to My Complaints
        </a>
    </div>
</div>

<div class="container-fluid px-lg-5 mb-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 small mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger py-2 small mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- 10-Stage Visual Progress Ribbon -->
    <div class="ums-card p-4 mb-4">
        <h6 class="fw-bold mb-3" style="color: #0f2b48;">
            <i class="bi bi-diagram-2-fill text-primary me-2"></i>10-Stage Governance & Independent Verification Tracker
        </h6>

        <div class="d-flex flex-wrap justify-content-between align-items-center text-center gap-2 py-2">
            @{
                string[] stepLabels = [
                    "1. Submitted", 
                    "2. Under Review", 
                    "3. Approved", 
                    "4. Assigned", 
                    "5. Work Accepted", 
                    "6. In Progress", 
                    "7. Work Completed", 
                    "8. Verification Gate", 
                    "9. Verified Resolved", 
                    "10. Closed"
                ];

                for (int i = 1; i <= 10; i++)
                {
                    bool isPassed = currentStatusInt >= i && Model.Status != ComplaintStatus.Rejected;
                    bool isCurrent = currentStatusInt == i;
                    string bgClass = isCurrent ? "bg-warning text-dark border-dark fw-bold shadow-sm" : 
                                     isPassed ? "bg-success text-white" : "bg-light text-muted border";

                    <div class="p-2 rounded border @bgClass" style="min-width: 100px; flex: 1 1 0; font-size: 0.72rem;">
                        <div><i class="bi @(isPassed ? "bi-check-circle-fill" : "bi-circle")"></i></div>
                        <div>@stepLabels[i - 1]</div>
                    </div>
                }
            }
        </div>

        <div class="mt-2 text-center">
            <small class="text-muted">
                Current Status: <span class="badge bg-primary">@Model.Status</span> &bull; 
                Reported: @Model.CreatedAtUtc.ToString("dd MMM yyyy, hh:mm tt")
            </small>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Column: Issue Info & Photos -->
        <div class="col-lg-8">
            <!-- Problem Card -->
            <div class="ums-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">@Model.Title</h5>
                    <span class="badge bg-light text-dark border p-2">
                        <i class="bi @(Model.Category?.IconCssClass ?? "bi-tools") me-1 text-primary"></i>
                        @(Model.Category?.CategoryName ?? "General")
                    </span>
                </div>
                <p class="text-secondary" style="white-space: pre-line;">@Model.Description</p>

                <!-- Initial Problem Photos -->
                <div class="mt-4 pt-3 border-top">
                    <h6 class="fw-bold small text-dark mb-2">Photographs Attached at Reporting:</h6>
                    @if (!Model.Images.Any())
                    {
                        <p class="text-muted small fst-italic">No photographs uploaded with this complaint.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var img in Model.Images)
                            {
                                <a href="@img.ImageUrl" target="_blank">
                                    <img src="@img.ImageUrl" alt="Issue Photo" class="img-thumbnail" 
                                         style="width: 130px; height: 130px; object-fit: cover;" />
                                </a>
                            }
                        </div>
                    }
                </div>

                <!-- Independent Verification Proof Comparison -->
                @if (Model.WorkOrders.Any(w => w.Evidence.Any() || w.Verifications.Any()))
                {
                    <div class="mt-4 pt-3 border-top">
                        <div class="alert alert-success border-success">
                            <h6 class="fw-bold mb-2">
                                <i class="bi bi-patch-check-fill text-success me-1"></i> Independent Quality Inspection Sign-Off
                            </h6>
                            <div class="row g-3">
                                @foreach (var wo in Model.WorkOrders)
                                {
                                    @foreach (var ev in wo.Evidence)
                                    {
                                        <div class="col-sm-6">
                                            <div class="small fw-semibold text-muted mb-1">Technician After-Repair Photo:</div>
                                            <img src="@ev.ImageUrl" alt="Completion Proof" class="img-thumbnail border-success" 
                                                 style="width: 100%; max-height: 200px; object-fit: cover;" />
                                            <div class="small text-muted mt-1 font-italic">@ev.Notes</div>
                                        </div>
                                    }
                                    @foreach (var verif in wo.Verifications)
                                    {
                                        <div class="col-sm-6">
                                            <div class="small fw-semibold text-success mb-1">Supervisor Inspection Sign-Off:</div>
                                            <div class="p-2 bg-white rounded border small">
                                                <div><strong>Inspector Notes:</strong> @verif.InspectionNotes</div>
                                                <div class="text-muted mt-1">Inspected: @verif.VerifiedAtUtc.ToString("dd MMM yyyy, hh:mm tt")</div>
                                                <div class="badge bg-success mt-1">Approval Verified</div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Immutable Audit Trail History -->
            <div class="ums-card">
                <div class="ums-card-header bg-white">
                    <span class="fw-bold"><i class="bi bi-clock-history text-secondary me-2"></i>Immutable Audit Trail History</span>
                    <span class="badge bg-secondary">@Model.History.Count Events</span>
                </div>
                <div class="p-3">
                    <ul class="list-group list-group-flush small">
                        @foreach (var h in Model.History.OrderByDescending(h => h.TimestampUtc))
                        {
                            <li class="list-group-item px-0 py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-dark">
                                        <i class="bi bi-record-circle-fill text-primary me-1"></i> @h.Action
                                    </span>
                                    <span class="text-muted" style="font-size: 0.75rem;">
                                        @h.TimestampUtc.ToString("dd MMM yyyy, hh:mm tt")
                                    </span>
                                </div>
                                <div class="text-muted mt-1">@h.Remarks</div>
                                <small class="text-secondary opacity-75">By: @(h.ActorUser?.Email ?? "System Automated")</small>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Sidebar Column: Location & Feedback -->
        <div class="col-lg-4">
            <!-- Location Card -->
            <div class="ums-card p-3 mb-4">
                <h6 class="fw-bold mb-3" style="color: #0f2b48;">
                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> Campus Fault Location
                </h6>
                <div class="p-2 bg-light rounded border mb-2">
                    <div class="fw-bold text-dark">@(Model.Location?.Floor?.Building?.BuildingCode ?? "LPU")</div>
                    <div class="small text-muted">@(Model.Location?.Floor?.Building?.BuildingName)</div>
                </div>
                <div class="small text-secondary mb-1">
                    <strong>Floor:</strong> @(Model.Location?.Floor?.FloorName ?? "Ground")
                </div>
                <div class="small text-secondary mb-1">
                    <strong>Room / Facility:</strong> @(Model.Location?.RoomNumber) - @(Model.Location?.LocationName)
                </div>
                <div class="small text-secondary">
                    <strong>Zone Type:</strong> @(Model.Location?.Floor?.Building?.ZoneType)
                </div>
            </div>

            <!-- Priority & SLA Deadlines Card -->
            <div class="ums-card p-3 mb-4">
                <h6 class="fw-bold mb-3" style="color: #0f2b48;">
                    <i class="bi bi-stopwatch text-warning me-1"></i> Service Level Agreement (SLA)
                </h6>
                <div class="mb-2">
                    <span class="small text-muted">Priority:</span>
                    @if (Model.Priority != null)
                    {
                        <span class="badge bg-@Model.Priority.BadgeColor">@Model.Priority.PriorityName</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Awaiting Triage</span>
                    }
                </div>
                @if (Model.ResolutionDeadlineUtc.HasValue)
                {
                    <div class="small text-muted mb-1">
                        <strong>Target Resolution:</strong> @Model.ResolutionDeadlineUtc.Value.ToString("dd MMM, hh:mm tt")
                    </div>
                }
                @if (Model.IsOverdue)
                {
                    <div class="badge bg-danger p-2 w-100 text-center">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> SLA Breached & Escalated
                    </div>
                }
            </div>

            <!-- Feedback Submission Card (if VerifiedResolved) -->
            @if (Model.Status == ComplaintStatus.VerifiedResolved)
            {
                <div class="ums-card p-3 mb-4 border-success">
                    <h6 class="fw-bold text-success mb-2">
                        <i class="bi bi-star-fill text-warning me-1"></i> Rate Resolution Quality
                    </h6>
                    <p class="small text-muted mb-3">
                        Your maintenance issue was independently verified by the Department Supervisor. Please rate the quality of service.
                    </p>
                    <form asp-action="SubmitFeedback" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="complaintId" value="@Model.ComplaintId" />

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Rating (1 to 5 Stars)</label>
                            <select name="ratingStars" class="form-select form-select-sm">
                                <option value="5" selected>5 Stars - Excellent Repair</option>
                                <option value="4">4 Stars - Good Resolution</option>
                                <option value="3">3 Stars - Satisfactory</option>
                                <option value="2">2 Stars - Substandard</option>
                                <option value="1">1 Star - Very Poor</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Comments</label>
                            <textarea name="comments" class="form-control form-control-sm" rows="2" placeholder="Feedback for campus administration..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-success btn-sm w-100">
                            <i class="bi bi-check2-circle me-1"></i> Submit Feedback & Close Ticket
                        </button>
                    </form>

                    <hr class="my-3 border-secondary opacity-25" />

                    <!-- Dispute Button -->
                    <button class="btn btn-outline-danger btn-sm w-100" type="button" data-bs-toggle="collapse" data-bs-target="#disputeBox">
                        <i class="bi bi-exclamation-octagon me-1"></i> Issue Still Broken? Dispute within 48h
                    </button>
                    <div class="collapse mt-2" id="disputeBox">
                        <form asp-action="ReopenTicket" method="post" class="p-2 bg-light border rounded">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="complaintId" value="@Model.ComplaintId" />
                            <textarea name="disputeReason" class="form-control form-control-sm mb-2" rows="2" placeholder="Explain why the issue is not fixed..." required></textarea>
                            <button type="submit" class="btn btn-danger btn-sm w-100">Reopen Ticket</button>
                        </form>
                    </div>
                </div>
            }

            @if (Model.Status == ComplaintStatus.Closed && Model.Feedbacks.Any())
            {
                var fb = Model.Feedbacks.First();
                <div class="ums-card p-3 mb-4 bg-light">
                    <h6 class="fw-bold text-dark small mb-1">
                        <i class="bi bi-star-fill text-warning me-1"></i> Reporter Service Review
                    </h6>
                    <div class="text-warning mb-1">
                        @for (int s = 0; s < fb.RatingStars; s++) { <i class="bi bi-star-fill"></i> }
                    </div>
                    <div class="small text-muted font-italic">"@fb.Comments"</div>
                </div>
            }
        </div>
    </div>
</div>
