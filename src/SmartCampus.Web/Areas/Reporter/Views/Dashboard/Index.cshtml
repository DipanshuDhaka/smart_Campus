@model IEnumerable<SmartCampus.Web.Models.Entities.Complaint>
@using SmartCampus.Web.Models.Enums
@{
    ViewData["Title"] = "Student & Faculty Maintenance Portal";
}

<!-- Page Header Ribbon -->
<div class="ums-page-header">
    <div class="container-fluid px-lg-5 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="ums-page-title"><i class="bi bi-mortarboard-fill me-2"></i>Student & Faculty Service Portal</h4>
            <div class="ums-breadcrumb text-muted">
                Lovely Professional University &bull; Facilities Maintenance & Care &bull; Campus Self-Service
            </div>
        </div>
        <div>
            <a asp-area="Reporter" asp-controller="Complaints" asp-action="Create" class="btn btn-ums-orange">
                <i class="bi bi-plus-circle-fill me-1"></i> Report New Campus Issue
            </a>
        </div>
    </div>
</div>

<div class="container-fluid px-lg-5">
    <!-- Stat Tiles -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="ums-stat-card">
                <div class="ums-stat-number">@ViewBag.TotalLogged</div>
                <div class="ums-stat-label">Total Reported By Me</div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="ums-stat-card stat-warning">
                <div class="ums-stat-number text-warning">@ViewBag.ActiveCount</div>
                <div class="ums-stat-label">Currently In Progress</div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="ums-stat-card stat-success">
                <div class="ums-stat-number text-success">@ViewBag.ResolvedCount</div>
                <div class="ums-stat-label">Quality Verified & Resolved</div>
            </div>
        </div>
    </div>

    <!-- My Complaints Table -->
    <div class="ums-card">
        <div class="ums-card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-bold"><i class="bi bi-card-checklist me-2"></i>My Reported Campus Issues</span>
            <span class="badge bg-secondary">@Model.Count() Total Tickets</span>
        </div>
        <div class="table-responsive">
            <table class="table ums-table align-middle">
                <thead>
                    <tr>
                        <th>Ticket #</th>
                        <th>Problem Summary</th>
                        <th>Campus Location</th>
                        <th>Category</th>
                        <th>Submitted Date</th>
                        <th>Resolution Status</th>
                        <th>Timeline</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox text-muted fs-1 d-block mb-2"></i>
                                You haven't reported any campus maintenance issues yet.
                                <div class="mt-2">
                                    <a asp-area="Reporter" asp-controller="Complaints" asp-action="Create" class="btn btn-sm btn-ums-primary">
                                        <i class="bi bi-plus-lg me-1"></i> Report an Issue
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            string badgeClass = item.Status switch
                            {
                                ComplaintStatus.Submitted => "badge-submitted",
                                ComplaintStatus.UnderReview => "badge-under-review",
                                ComplaintStatus.Assigned => "badge-assigned",
                                ComplaintStatus.WorkAccepted => "badge-work-accepted",
                                ComplaintStatus.InProgress => "badge-in-progress",
                                ComplaintStatus.WorkCompleted => "badge-work-completed",
                                ComplaintStatus.AwaitingVerification => "badge-awaiting-verification",
                                ComplaintStatus.VerifiedResolved => "badge-verified-resolved",
                                ComplaintStatus.ReworkRequired => "badge-rework-required",
                                ComplaintStatus.Closed => "badge-closed",
                                _ => "badge-rejected"
                            };

                            <tr>
                                <td class="fw-bold font-monospace small">@item.TicketNumber</td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.Title</div>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">@item.Description</small>
                                </td>
                                <td class="small">
                                    <span class="fw-semibold">@(item.Location?.Floor?.Building?.BuildingCode ?? "LPU")</span>
                                    <div class="text-muted">@(item.Location?.RoomNumber ?? "General")</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(item.Category?.CategoryName ?? "General")
                                    </span>
                                </td>
                                <td class="small text-muted">
                                    @item.CreatedAtUtc.ToString("dd MMM yyyy, hh:mm tt")
                                </td>
                                <td>
                                    <span class="badge-status @badgeClass">@item.Status</span>
                                </td>
                                <td>
                                    <a asp-area="Reporter" asp-controller="Complaints" asp-action="Details" asp-route-id="@item.ComplaintId" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-clock-history me-1"></i> View Progress
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
