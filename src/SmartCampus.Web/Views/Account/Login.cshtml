@{
    ViewData["Title"] = "Institutional Sign-In | LPU SmartCampus";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <div class="ums-card shadow-sm border-0">
                <div class="row g-0">
                    <!-- Left Brand Column -->
                    <div class="col-md-5 d-flex flex-column justify-content-between p-4 p-lg-5 text-white" 
                         style="background: linear-gradient(135deg, #0a1e33 0%, #0f2b48 100%); border-right: 3px solid #e86c00;">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <span class="badge bg-warning text-dark px-2 py-1 fw-bold me-2">UMS</span>
                                <span class="text-uppercase fw-semibold tracking-wider text-light small">Lovely Professional University</span>
                            </div>
                            <h3 class="fw-bold text-white mb-2">SmartCampus</h3>
                            <p class="text-light small opacity-75 mb-4">
                                Intelligent Campus Issue Reporting, Workforce Allocation & Independent Resolution Verification Portal.
                            </p>
                            
                            <hr class="border-secondary my-4" />
                            
                            <div class="mb-3">
                                <div class="fw-bold small text-warning mb-1"><i class="bi bi-shield-check me-1"></i> Quality Verified</div>
                                <div class="small text-light opacity-75">Work is independently inspected before ticket closure.</div>
                            </div>
                            <div class="mb-3">
                                <div class="fw-bold small text-info mb-1"><i class="bi bi-geo-alt-fill me-1"></i> 600+ Acres Campus</div>
                                <div class="small text-light opacity-75">Dynamic block, floor, and QR-guided issue dispatch.</div>
                            </div>
                            <div>
                                <div class="fw-bold small text-success mb-1"><i class="bi bi-stopwatch me-1"></i> Enforced SLAs</div>
                                <div class="small text-light opacity-75">Automated multi-tier reminder and escalation engine.</div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top border-secondary small text-light opacity-75">
                            <i class="bi bi-telephone-fill me-1 text-warning"></i> Campus Control Desk: <strong>+91-1824-517000</strong>
                        </div>
                    </div>

                    <!-- Right Login Form Column -->
                    <div class="col-md-7 p-4 p-lg-5 bg-white">
                        <div class="text-center mb-4">
                            <h4 class="fw-bold" style="color: #0f2b48;">Portal Sign-In</h4>
                            <p class="text-muted small">Choose your authorized institutional sign-in method</p>
                        </div>

                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger py-2 small mb-4" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
                            </div>
                        }

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2 small mb-4" role="alert">
                                <div asp-validation-summary="All" class="mb-0"></div>
                            </div>
                        }

                        <!-- Google OAuth 2.0 Button -->
                        <form asp-action="ExternalLogin" method="post" class="mb-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="provider" value="Google" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn btn-outline-dark w-100 py-2 d-flex align-items-center justify-content-center shadow-sm">
                                <svg class="me-2" width="20" height="20" viewBox="0 0 48 48">
                                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                                </svg>
                                <span class="fw-semibold">Continue with Google</span>
                            </button>
                            <div class="text-center mt-1">
                                <small class="text-muted" style="font-size: 0.72rem;">Authorized domains: @@lpu.co.in | @@lpu.in</small>
                            </div>
                        </form>

                        <div class="position-relative my-4">
                            <hr class="border-secondary opacity-25" />
                            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">
                                or UMS Staff Credentials
                            </span>
                        </div>

                        <!-- Direct Credential Form -->
                        <form asp-action="Login" method="post" id="loginForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@returnUrl" />

                            <div class="mb-3">
                                <label for="emailInput" class="form-label small fw-semibold text-secondary">Institutional Email</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                                    <input type="email" name="email" id="emailInput" class="form-control border-start-0" 
                                           placeholder="user@smartcampus.lpu.in" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="passwordInput" class="form-label small fw-semibold text-secondary">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock"></i></span>
                                    <input type="password" name="password" id="passwordInput" class="form-control border-start-0" 
                                           placeholder="••••••••" required />
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input type="checkbox" name="rememberMe" value="true" class="form-check-input" id="rememberMeCheck" checked />
                                    <label class="form-check-label small text-muted" for="rememberMeCheck">Remember session</label>
                                </div>
                                <a href="javascript:void(0)" class="small text-decoration-none" style="color: #e86c00;">Forgot Password?</a>
                            </div>

                            <button type="submit" class="btn btn-ums-primary w-100 py-2">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to UMS
                            </button>
                        </form>

                        <!-- Evaluation Role Switcher for Fast Evaluation -->
                        <div class="mt-4 p-3 bg-light rounded border">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold small" style="color: #0f2b48;">
                                    <i class="bi bi-person-badge me-1"></i> Quick Role Switcher (Evaluation Demo)
                                </span>
                                <span class="badge bg-secondary" style="font-size: 0.65rem;">5 Roles</span>
                            </div>
                            <div class="d-grid gap-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary text-start py-1" onclick="fillCreds('superadmin@smartcampus.lpu.in', 'Admin@12345')">
                                    <i class="bi bi-shield-lock-fill text-danger me-1"></i> <strong>Super Admin:</strong> Prof. R. K. Sharma
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary text-start py-1" onclick="fillCreds('controldesk@smartcampus.lpu.in', 'Admin@12345')">
                                    <i class="bi bi-display-fill text-primary me-1"></i> <strong>Campus Control Desk:</strong> Officer Harpreet
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary text-start py-1" onclick="fillCreds('elec.head@smartcampus.lpu.in', 'Super@12345')">
                                    <i class="bi bi-check2-circle text-warning me-1"></i> <strong>Supervisor:</strong> Er. Manjit (Electrical Head)
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary text-start py-1" onclick="fillCreds('technician.rajesh@smartcampus.lpu.in', 'Worker@12345')">
                                    <i class="bi bi-tools text-info me-1"></i> <strong>Maintenance Worker:</strong> Rajesh Verma (Electrician)
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary text-start py-1" onclick="fillCreds('student.test@lpu.in', 'Student@12345')">
                                    <i class="bi bi-mortarboard-fill text-success me-1"></i> <strong>Student:</strong> Aarav Sharma (B.Tech CSE)
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillCreds(email, pass) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = pass;
            document.getElementById('loginForm').submit();
        }
    </script>
}
