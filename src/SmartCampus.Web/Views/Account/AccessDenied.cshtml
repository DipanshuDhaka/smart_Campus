@{
    ViewData["Title"] = "Access Denied | LPU SmartCampus";
}

<div class="container py-5 text-center">
    <div class="ums-card p-5 mx-auto shadow-sm" style="max-width: 600px;">
        <div class="mb-3 text-danger">
            <i class="bi bi-shield-slash-fill" style="font-size: 4rem;"></i>
        </div>
        <h3 class="fw-bold text-danger mb-2">Access Denied</h3>
        <p class="text-muted mb-4">
            You do not possess the required institutional role authorization to access this protected portal resource.
        </p>
        <div class="p-3 bg-light rounded text-start small mb-4 border">
            <strong>Security Rule Enforcement:</strong>
            <ul class="mb-0 mt-2 text-secondary">
                <li>Students & Faculty can only access the Complaint Reporting portal.</li>
                <li>Maintenance Workers can only view tasks dispatched to their assigned roster.</li>
                <li>Independent Verification sign-offs are strictly restricted to Department Supervisors.</li>
                <li>Elevations to privileged administrative roles require explicit Campus Admin approval.</li>
            </ul>
        </div>
        <div class="d-flex justify-content-center gap-2">
            <a asp-action="RedirectToRoleDashboard" asp-controller="Account" class="btn btn-ums-primary px-4">
                <i class="bi bi-speedometer2 me-1"></i> Return to My Dashboard
            </a>
            <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary px-4">
                <i class="bi bi-house me-1"></i> Home
            </a>
        </div>
    </div>
</div>
