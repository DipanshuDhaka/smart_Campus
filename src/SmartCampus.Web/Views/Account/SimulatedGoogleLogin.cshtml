@{
    ViewData["Title"] = "Sign in with Google - LPU Institutional SSO";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card ums-card shadow border">
                <div class="card-body p-4 text-center">
                    <!-- Google Identity Header -->
                    <div class="mb-3">
                        <svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="48px" height="48px" viewBox="0 0 48 48">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path>
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path>
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path>
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path>
                            <path fill="none" d="M0 0h48v48H0z"></path>
                        </svg>
                    </div>

                    <h5 class="fw-bold text-dark mb-1">Sign in with Google</h5>
                    <p class="text-muted small mb-4">
                        to continue to <strong>Lovely Professional University SmartCampus</strong>
                    </p>

                    <div class="alert alert-info py-2 small text-start mb-4" role="alert">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        <strong>Evaluation Environment:</strong> Live Google Cloud Client ID is in prototype mode. Enter or select an institutional email to evaluate Google identity validation and domain whitelist rules.
                    </div>

                    <!-- 1. Quick Select Institutional Personas -->
                    <div class="list-group mb-4 text-start">
                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2"
                                onclick="selectAccount('student.aarav@lpu.in', 'Aarav Sharma')">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                <i class="bi bi-person"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold small text-dark">Aarav Sharma</div>
                                <div class="text-muted" style="font-size: 0.75rem;">student.aarav@lpu.in <span class="badge bg-success" style="font-size: 0.65rem;">Approved Domain</span></div>
                            </div>
                        </button>

                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2"
                                onclick="selectAccount('faculty.priya@lpu.co.in', 'Dr. Priya Nair')">
                            <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                <i class="bi bi-mortarboard"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold small text-dark">Dr. Priya Nair</div>
                                <div class="text-muted" style="font-size: 0.75rem;">faculty.priya@lpu.co.in <span class="badge bg-success" style="font-size: 0.65rem;">Approved Domain</span></div>
                            </div>
                        </button>

                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2"
                                onclick="selectAccount('visitor.guest@yahoo.com', 'External Visitor')">
                            <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                <i class="bi bi-x-circle"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold small text-dark">External Visitor (Test Whitelist Rejection)</div>
                                <div class="text-muted" style="font-size: 0.75rem;">visitor.guest@yahoo.com <span class="badge bg-danger" style="font-size: 0.65rem;">Forbidden Domain</span></div>
                            </div>
                        </button>
                    </div>

                    <!-- 2. Custom Email Input Form -->
                    <form asp-action="ProcessSimulatedGoogleLogin" method="post" id="googleLoginForm" class="text-start">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Or enter any Google Institutional Email</label>
                            <input type="email" name="googleEmail" id="googleEmailInput" class="form-control" 
                                   placeholder="e.g. yourname@lpu.in" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Full Name</label>
                            <input type="text" name="fullName" id="fullNameInput" class="form-control" 
                                   placeholder="e.g. Rajesh Kumar" />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary py-2 fw-semibold">
                                Complete Google Verification & Sign In
                            </button>
                            <a asp-action="Login" class="btn btn-light btn-sm text-muted">
                                Cancel & Return to Login
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectAccount(email, name) {
            document.getElementById('googleEmailInput').value = email;
            document.getElementById('fullNameInput').value = name;
            document.getElementById('googleLoginForm').submit();
        }
    </script>
}
