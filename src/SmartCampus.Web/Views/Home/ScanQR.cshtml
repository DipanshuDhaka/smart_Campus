@{
    ViewData["Title"] = "Campus QR Location Scanner";
}

<div class="ums-page-header">
    <div class="container-fluid px-lg-5 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="ums-page-title"><i class="bi bi-qr-code-scan text-warning me-2"></i>Campus QR Location Scanner</h4>
            <div class="ums-breadcrumb text-muted">
                Lovely Professional University &bull; Doorplate & Asset Quick-Scan
            </div>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-house me-1"></i> Home
        </a>
    </div>
</div>

<div class="container-fluid px-lg-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="ums-card p-4 shadow-sm text-center">
                <div class="mb-3">
                    <span class="badge bg-warning text-dark px-3 py-1 fw-bold">Instant Location Identification</span>
                </div>
                <h5 class="fw-bold text-dark mb-2">Scan Doorplate or Pole QR Code</h5>
                <p class="text-muted small mb-4">
                    Point your camera at any campus QR code located on classroom doorplates, lab entrances, or outdoor streetlight poles to auto-fill the complaint form.
                </p>

                <!-- Camera Stream Container -->
                <div class="position-relative mx-auto border rounded overflow-hidden bg-black mb-4" 
                     style="max-width: 380px; height: 280px; display: flex; align-items: center; justify-content: center;">
                    <video id="cameraStream" autoplay playsinline style="width: 100%; height: 100%; object-fit: cover;"></video>
                    <canvas id="qrCanvas" style="display: none;"></canvas>
                    
                    <!-- Scan Guide Overlay -->
                    <div class="position-absolute border border-warning border-3 rounded" 
                         style="width: 200px; height: 200px; box-shadow: 0 0 0 9999px rgba(0,0,0,0.5); pointer-events: none;">
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-2 mb-4">
                    <button type="button" class="btn btn-ums-primary btn-sm" onclick="startCamera()">
                        <i class="bi bi-camera-video me-1"></i> Start Camera
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="stopCamera()">
                        <i class="bi bi-camera-video-off me-1"></i> Stop Camera
                    </button>
                </div>

                <hr class="border-secondary opacity-25 my-4" />

                <!-- Manual GUID / Code Entry -->
                <div class="text-start">
                    <label class="form-label small fw-semibold text-dark">
                        <i class="bi bi-keyboard me-1"></i> Or Enter Location GUID Manually:
                    </label>
                    <div class="input-group">
                        <input type="text" id="manualGuidInput" class="form-control form-control-sm font-monospace" 
                               placeholder="e.g. 7f938d2a-4c1b-481a-96ea-..." />
                        <button type="button" class="btn btn-ums-orange btn-sm px-3" onclick="navigateManualGuid()">
                            Resolve Location
                        </button>
                    </div>
                    <small class="text-muted" style="font-size: 0.72rem;">Found below the dynamic QR matrix on physical stickers.</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let stream = null;

        function startCamera() {
            if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                navigator.mediaDevices.getUserMedia({ video: { facingMode: "environment" } })
                    .then(function (mediaStream) {
                        stream = mediaStream;
                        const video = document.getElementById('cameraStream');
                        video.srcObject = mediaStream;
                    })
                    .catch(function (err) {
                        alert("Camera access denied or unavailable: " + err);
                    });
            } else {
                alert("getUserMedia is not supported by your browser.");
            }
        }

        function stopCamera() {
            if (stream) {
                stream.getTracks().forEach(track => track.stop());
                document.getElementById('cameraStream').srcObject = null;
            }
        }

        function navigateManualGuid() {
            const guid = document.getElementById('manualGuidInput').value.trim();
            if (!guid) {
                alert("Please enter a valid Location GUID.");
                return;
            }
            window.location.href = `/Reporter/Complaints/Create?locId=${encodeURIComponent(guid)}`;
        }
    </script>
}
