@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartCampus | Lovely Professional University</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Leaflet GIS Map CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- LPU UMS Formal Theme CSS -->
    <link rel="stylesheet" href="~/css/lpu-ums.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- 1. Institutional Top Bar -->
    <div class="ums-topbar">
        <div class="container-fluid px-lg-5 d-flex justify-content-between align-items-center">
            <div>
                <span class="me-3"><i class="bi bi-mortarboard-fill text-warning me-1"></i> Lovely Professional University</span>
                <span class="d-none d-md-inline text-muted">|</span>
                <span class="d-none d-md-inline ms-3 text-light opacity-75">Campus Maintenance & Estate Governance Portal</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="text-warning fw-semibold">
                    <i class="bi bi-telephone-fill me-1"></i> Control Desk: +91-1824-517000
                </span>
                <span class="text-light opacity-50">|</span>
                <span class="text-light opacity-75 d-none d-sm-inline">
                    <i class="bi bi-clock me-1"></i> IST (UTC+5:30)
                </span>
            </div>
        </div>
    </div>

    <!-- 2. Main University Header & Navbar -->
    <nav class="navbar navbar-expand-lg ums-navbar">
        <div class="container-fluid px-lg-5">
            <!-- Brand -->
            <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                <div class="bg-warning text-dark fw-bold rounded px-2 py-1 me-2 shadow-sm" style="font-size: 1.1rem; border: 2px solid #ffffff;">
                    LPU
                </div>
                <div>
                    <span class="ums-brand-title">SmartCampus</span>
                    <span class="ums-brand-subtitle">Intelligent Issue & Workforce Management</span>
                </div>
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler border-secondary text-white" type="button" data-bs-toggle="collapse" data-bs-target="#umsNavbarContent" 
                    aria-controls="umsNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list text-white fs-4"></i>
            </button>

            <!-- Nav Links & Role Aware Navigation -->
            <div class="collapse navbar-collapse" id="umsNavbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                    <li class="nav-item">
                        <a class="nav-link ums-nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link ums-nav-link" asp-area="" asp-controller="Home" asp-action="CampusMap">
                            <i class="bi bi-map me-1"></i> Campus Map
                        </a>
                    </li>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("CampusAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link ums-nav-link text-warning fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Control Desk
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ums-nav-link" asp-area="Admin" asp-controller="Triage" asp-action="Index">
                                    <i class="bi bi-inbox-fill me-1"></i> Triage Queue
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ums-nav-link" asp-area="Admin" asp-controller="Buildings" asp-action="Index">
                                    <i class="bi bi-building me-1"></i> 60+ Buildings
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ums-nav-link" asp-area="Admin" asp-controller="SLAMonitor" asp-action="Index">
                                    <i class="bi bi-stopwatch me-1"></i> SLA Monitor
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ums-nav-link" asp-area="Admin" asp-controller="Analytics" asp-action="Index">
                                    <i class="bi bi-graph-up me-1"></i> Analytics
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("DepartmentSupervisor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link ums-nav-link text-warning fw-bold" asp-area="Supervisor" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-shield-check me-1"></i> Supervisor Hub
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ums-nav-link" asp-area="Supervisor" asp-controller="WorkOrders" asp-action="Index">
                                    <i class="bi bi-clipboard2-data me-1"></i> Team Work Orders
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ums-nav-link" asp-area="Supervisor" asp-controller="Verification" asp-action="Index">
                                    <i class="bi bi-patch-check-fill text-warning me-1"></i> Verification Gate
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("MaintenanceWorker"))
                        {
                            <li class="nav-item">
                                <a class="nav-link ums-nav-link text-warning fw-bold" asp-area="Worker" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-tools me-1"></i> My Tasks
                                </a>
                            </li>
                        }
                        else
                        {
                            <!-- Student / Faculty -->
                            <li class="nav-item">
                                <a class="nav-link ums-nav-link text-warning fw-bold" asp-area="Reporter" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-grid-fill me-1"></i> My Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ums-nav-link" asp-area="Reporter" asp-controller="Complaints" asp-action="Create">
                                    <i class="bi bi-plus-circle-fill text-warning me-1"></i> Report Issue
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ums-nav-link" asp-area="Reporter" asp-controller="Complaints" asp-action="Index">
                                    <i class="bi bi-card-checklist me-1"></i> My Complaints
                                </a>
                            </li>
                        }
                    }
                </ul>

                <!-- User Profile & Auth Controls -->
                <div class="d-flex align-items-center gap-2">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var userEmail = User.Identity?.Name ?? "User";
                        string roleBadge = "Student / Faculty";
                        string badgeClass = "bg-success";

                        if (User.IsInRole("SuperAdmin")) { roleBadge = "Super Admin"; badgeClass = "bg-danger"; }
                        else if (User.IsInRole("CampusAdmin")) { roleBadge = "Control Desk"; badgeClass = "bg-primary"; }
                        else if (User.IsInRole("DepartmentSupervisor")) { roleBadge = "Supervisor"; badgeClass = "bg-warning text-dark"; }
                        else if (User.IsInRole("MaintenanceWorker")) { roleBadge = "Technician"; badgeClass = "bg-info text-dark"; }

                        <a asp-area="" asp-controller="Notifications" asp-action="Index" class="btn btn-outline-light btn-sm position-relative me-1" title="Notification Center">
                            <i class="bi bi-bell-fill"></i>
                        </a>

                        <div class="dropdown">
                            <button class="btn ums-user-badge dropdown-toggle" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-6"></i>
                                <div class="text-start d-none d-sm-block">
                                    <div class="fw-bold" style="line-height: 1.1;">@userEmail.Split('@')[0]</div>
                                    <small class="badge @badgeClass" style="font-size: 0.65rem;">@roleBadge</small>
                                </div>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenuDropdown">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-bold text-dark small">@userEmail</div>
                                    <div class="small text-muted">Role: <span class="badge @badgeClass">@roleBadge</span></div>
                                </li>
                                <li>
                                    <a class="dropdown-item small" asp-area="" asp-controller="Account" asp-action="RedirectToRoleDashboard">
                                        <i class="bi bi-speedometer2 me-2"></i> My Portal Dashboard
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item small text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-ums-orange btn-sm px-3">
                            <i class="bi bi-person-check-fill me-1"></i> Sign In to UMS
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- 3. Main Content Body -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- 4. Formal Institutional Footer -->
    <footer class="ums-footer">
        <div class="container-fluid px-lg-5">
            <div class="row g-4 mb-3">
                <div class="col-md-4">
                    <div class="fw-bold text-dark mb-2" style="font-size: 0.95rem;">
                        <span class="badge bg-warning text-dark px-2 me-1">UMS</span> LOVELY PROFESSIONAL UNIVERSITY
                    </div>
                    <p class="text-muted small mb-1">
                        Jalandhar - Delhi G.T. Road, Phagwara, Punjab (India) - 144411
                    </p>
                    <p class="text-muted small">
                        SmartCampus Facility & Estate Management System (.NET 10 LTS)
                    </p>
                </div>
                <div class="col-md-4">
                    <div class="fw-bold text-dark mb-2" style="font-size: 0.85rem; text-transform: uppercase;">
                        Emergency & Escalation Numbers
                    </div>
                    <ul class="list-unstyled small text-muted">
                        <li><i class="bi bi-telephone text-danger me-1"></i> Central Control Desk: <strong>+91-1824-517000</strong></li>
                        <li><i class="bi bi-hospital text-danger me-1"></i> Uni-Hospital Medical Hotline: <strong>Ext. 108 / 102</strong></li>
                        <li><i class="bi bi-shield-exclamation text-warning me-1"></i> Campus Security Division: <strong>Ext. 100 / 112</strong></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <div class="fw-bold text-dark mb-2" style="font-size: 0.85rem; text-transform: uppercase;">
                        System Governance & Methodology
                    </div>
                    <div class="small text-muted mb-2">
                        Governed by the Independent Quality Verification Gate: 
                        <span class="badge bg-dark">Work Completed &ne; Resolved</span>
                    </div>
                    <div class="small text-muted">
                        Active Reference Campus: <strong>600+ Acres, 60+ Blocks</strong>
                    </div>
                </div>
            </div>
            <hr class="border-secondary opacity-25 my-3" />
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center small text-muted">
                <div>&copy; 2026 Lovely Professional University. All Rights Reserved.</div>
                <div>SmartCampus Enterprise Facilities Management Portal v1.0.0</div>
            </div>
        </div>
    </footer>

    <!-- Toast Container for SignalR Real-Time Notifications -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;" id="liveToastContainer"></div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
