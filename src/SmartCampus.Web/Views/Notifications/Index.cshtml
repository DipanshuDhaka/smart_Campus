@model IEnumerable<SmartCampus.Web.Models.Entities.Notification>
@{
    ViewData["Title"] = "Institutional Notification Center";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-lg-5 py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-bell-fill text-primary me-2"></i>Institutional Notification Center
            </h3>
            <p class="text-muted small mb-0">
                Official notifications, ticket lifecycle updates, workforce assignments, and SLA threshold alerts for your account.
            </p>
        </div>
        <div class="mt-3 mt-md-0">
            <span class="badge bg-light text-dark border p-2">
                <i class="bi bi-person-badge me-1"></i> Logged in as: <strong>@User.Identity?.Name</strong>
            </span>
        </div>
    </div>

    <!-- Notification Cards List -->
    <div class="row">
        <div class="col-lg-10 mx-auto">
            @if (!Model.Any())
            {
                <div class="card ums-card shadow-sm text-center py-5">
                    <div class="card-body">
                        <i class="bi bi-bell-slash text-muted" style="font-size: 3rem;"></i>
                        <h5 class="fw-bold text-dark mt-3">No Notifications</h5>
                        <p class="text-muted small mb-0">You have no active alerts or system notifications at this moment.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="card ums-card shadow-sm">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark">
                            <i class="bi bi-inbox-fill text-primary me-2"></i>Recent Alerts & Updates (@Model.Count())
                        </span>
                        <span class="badge bg-primary">
                            @Model.Count(n => !n.IsRead) Unread
                        </span>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model)
                        {
                            var badgeClass = item.NotificationType switch
                            {
                                "Danger" => "bg-danger",
                                "Warning" => "bg-warning text-dark",
                                "Success" => "bg-success",
                                _ => "bg-primary"
                            };

                            var iconClass = item.NotificationType switch
                            {
                                "Danger" => "bi-exclamation-octagon-fill text-danger",
                                "Warning" => "bi-exclamation-triangle-fill text-warning",
                                "Success" => "bi-check-circle-fill text-success",
                                _ => "bi-info-circle-fill text-primary"
                            };

                            var bgClass = item.IsRead ? "bg-white" : "bg-light border-start border-4 border-primary";

                            <div class="list-group-item p-3 @bgClass">
                                <div class="d-flex w-100 justify-content-between align-items-start">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="mt-1">
                                            <i class="bi @iconClass" style="font-size: 1.4rem;"></i>
                                        </div>
                                        <div>
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <h6 class="mb-0 fw-bold text-dark">@item.Title</h6>
                                                <span class="badge @badgeClass" style="font-size: 0.7rem;">@item.NotificationType</span>
                                                @if (!item.IsRead)
                                                {
                                                    <span class="badge bg-danger rounded-pill" style="font-size: 0.65rem;">NEW</span>
                                                }
                                            </div>
                                            <p class="text-muted small mb-2">@item.Message</p>
                                            <div class="d-flex align-items-center gap-3">
                                                <span class="text-muted" style="font-size: 0.75rem;">
                                                    <i class="bi bi-clock me-1"></i>@item.CreatedAtUtc.ToString("dd MMM yyyy, HH:mm") UTC
                                                </span>
                                                @if (!string.IsNullOrEmpty(item.TargetUrl))
                                                {
                                                    <a href="@item.TargetUrl" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.75rem;">
                                                        <i class="bi bi-box-arrow-up-right me-1"></i>View Ticket
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    @if (!item.IsRead)
                                    {
                                        <form asp-action="MarkAsRead" method="post" class="ms-3">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.NotificationId" />
                                            <button type="submit" class="btn btn-light btn-sm text-muted border" title="Mark as read">
                                                <i class="bi bi-check2"></i> Mark Read
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
